@page "/profile/images"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IProfileSetupClient ProfileClient
@inject IStringLocalizer<ProfileResource> L
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@L["ProfileImages_PageTitle"]</PageTitle>

<div class="bg-base-100 px-6 py-12 lg:py-20">
    <div class="mx-auto max-w-4xl">
        <section class="card bg-base-200 border-base-300 rounded-3xl border p-6 shadow-sm lg:p-8">
            <div class="mb-6 space-y-2">
                <h1 class="text-base-content text-3xl font-bold">@L["ProfileImages_Title"]</h1>
                <p class="text-base-content/70">@L["ProfileImages_Description"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-error mb-4">@errorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success mb-4">@successMessage</div>
            }

            @if (isLoading)
            {
                <div class="text-base-content/70">@L["ProfileSetup_Loading"]</div>
            }
            else
            {
                <fieldset class="fieldset space-y-4">
                    <legend class="fieldset-legend">@L["ProfileSetup_ProfileImage"]</legend>
                    <p class="text-base-content/70 text-sm">
                        @L["ProfileSetup_ProfileImageCount", profileImages.Count, MaximumProfileImages]
                    </p>
                    @if (profileImages.Count > 0)
                    {
                        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
                            @foreach (var image in profileImages)
                            {
                                <div class="border-base-300 bg-base-100 relative rounded-2xl border p-3">
                                    <button class="btn btn-error btn-circle btn-sm absolute top-2 right-2 z-10 shadow"
                                            type="button"
                                            aria-label="@L["ProfileSetup_DeleteImage"]"
                                            title="@L["ProfileSetup_DeleteImage"]"
                                            disabled="@(isUploadingImages || settingAvatarId.HasValue || deletingImageId.HasValue)"
                                            @onclick="() => DeleteProfileImageAsync(image.Id)">
                                        @if (deletingImageId == image.Id)
                                        {
                                            <span class="loading loading-spinner loading-xs" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4h8v2m-11 0 1 14h12l1-14M10 11v6m4-6v6" />
                                            </svg>
                                        }
                                    </button>
                                    <img src="@image.Url" alt="@L["ProfileSetup_ProfileImageAlt"]" class="h-32 w-full rounded-xl object-cover" />
                                    @if (image.IsAvatar)
                                    {
                                        <p class="text-primary mt-2 text-sm font-semibold">@L["ProfileSetup_CurrentAvatar"]</p>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline mt-2 w-full" type="button"
                                                disabled="@(isUploadingImages || settingAvatarId.HasValue || deletingImageId.HasValue)"
                                                @onclick="() => SetAvatarAsync(image.Id)">
                                            @(settingAvatarId == image.Id ? L["ProfileSetup_SavingButton"] : L["ProfileSetup_SetAsAvatar"])
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <InputFile OnChange="HandleImagesSelected" multiple accept="image/jpeg,image/png,image/webp"
                               disabled="@(isUploadingImages || settingAvatarId.HasValue || deletingImageId.HasValue || profileImages.Count >= MaximumProfileImages)"
                               class="file-input file-input-bordered w-full" />
                    @if (isUploadingImages)
                    {
                        <p class="text-base-content/70 text-sm" role="status">@L["ProfileSetup_UploadingImages"]</p>
                    }
                    <p class="text-base-content/70 text-sm">@L["ProfileSetup_ProfileImageHint"]</p>
                </fieldset>

                <div class="mt-6 flex flex-wrap gap-3">
                    <button class="btn btn-outline rounded-full" type="button" @onclick="NavigateToProfileSetup">
                        @L["ProfileImages_BackToProfile"]
                    </button>
                    <button class="btn btn-primary rounded-full" type="button" @onclick="FinishSetup">
                        @L["ProfileImages_Finish"]
                    </button>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private IReadOnlyList<ProfileImageResponse> profileImages = [];
    private List<IBrowserFile> selectedImages = [];
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = true;
    private bool isUploadingImages;
    private Guid? settingAvatarId;
    private Guid? deletingImageId;

    private const long MaximumProfileImageSizeBytes = 5 * 1024 * 1024;
    private const int MaximumProfileImages = 6;

    private void NavigateToProfileSetup() => Navigation.NavigateTo("/profile/setup");

    private void FinishSetup() => Navigation.NavigateTo("/");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await ProfileClient.GetProfileSetupAsync();
            if (response.Profile.StudyDomainId is null
                || response.Profile.SchoolId is null
                || response.Profile.LanguageId is null
                || response.Profile.IntentionIds.Count == 0
                || response.Profile.EthnicityId is null)
            {
                Navigation.NavigateTo("/profile/setup");
                return;
            }

            profileImages = response.ProfileImages;
        }
        catch (ApiClientException)
        {
            errorMessage = L["ProfileSetup_LoadError"];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleImagesSelected(InputFileChangeEventArgs args)
    {
        errorMessage = null;
        successMessage = null;
        IReadOnlyList<IBrowserFile> images;
        try
        {
            images = args.GetMultipleFiles(MaximumProfileImages - profileImages.Count);
        }
        catch (InvalidOperationException)
        {
            errorMessage = L["ProfileSetup_ProfileImageLimitError"];
            return;
        }

        if (profileImages.Count + images.Count > MaximumProfileImages)
        {
            errorMessage = L["ProfileSetup_ProfileImageLimitError"];
            return;
        }

        foreach (var image in images)
        {
            if (image.Size is <= 0 or > MaximumProfileImageSizeBytes)
            {
                errorMessage = L["ProfileSetup_ProfileImageSizeError"];
                return;
            }

            var contentType = image.ContentType.ToLowerInvariant();
            if (contentType is not ("image/jpeg" or "image/png" or "image/webp"))
            {
                errorMessage = L["ProfileSetup_ProfileImageTypeError"];
                return;
            }
        }

        selectedImages = images.ToList();
        await UploadSelectedImagesAsync();
    }

    private async Task UploadSelectedImagesAsync()
    {
        if (selectedImages.Count == 0)
            return;

        isUploadingImages = true;
        var openedStreams = new List<Stream>(selectedImages.Count);
        try
        {
            var uploads = new List<ProfileImageUploadRequest>(selectedImages.Count);
            foreach (var image in selectedImages)
            {
                var imageStream = image.OpenReadStream(MaximumProfileImageSizeBytes);
                openedStreams.Add(imageStream);
                uploads.Add(new ProfileImageUploadRequest(imageStream, image.Name, image.ContentType));
            }

            await ProfileClient.UploadProfileImagesAsync(uploads);
        }
        catch (ApiClientException)
        {
            errorMessage = L["ProfileSetup_ProfileImageUploadError"];
            return;
        }
        finally
        {
            foreach (var imageStream in openedStreams)
                await imageStream.DisposeAsync();
            isUploadingImages = false;
        }

        selectedImages.Clear();
        try
        {
            profileImages = (await ProfileClient.GetProfileSetupAsync()).ProfileImages;
            successMessage = L["ProfileSetup_ProfileImagesUploaded"];
        }
        catch (ApiClientException)
        {
            errorMessage = L["ProfileSetup_LoadError"];
        }
    }

    private async Task SetAvatarAsync(Guid imageId)
    {
        errorMessage = null;
        successMessage = null;
        settingAvatarId = imageId;

        try
        {
            await ProfileClient.SetAvatarAsync(imageId);
            profileImages = profileImages
                .Select(image => image with { IsAvatar = image.Id == imageId })
                .ToList();
            successMessage = L["ProfileSetup_AvatarUpdated"];
        }
        catch (ApiClientException)
        {
            errorMessage = L["ProfileSetup_AvatarUpdateError"];
        }
        finally
        {
            settingAvatarId = null;
        }
    }

    private async Task DeleteProfileImageAsync(Guid imageId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", L["ProfileSetup_DeleteImageConfirmation"].Value))
            return;

        errorMessage = null;
        successMessage = null;
        deletingImageId = imageId;

        try
        {
            await ProfileClient.DeleteProfileImageAsync(imageId);

            var deletedImage = profileImages.FirstOrDefault(image => image.Id == imageId);
            var remainingImages = profileImages.Where(image => image.Id != imageId).ToList();
            if (deletedImage?.IsAvatar == true && remainingImages.Count > 0)
            {
                var nextAvatarId = remainingImages.OrderBy(image => image.Id).First().Id;
                remainingImages = remainingImages
                    .Select(image => image with { IsAvatar = image.Id == nextAvatarId })
                    .ToList();
            }

            profileImages = remainingImages;
            successMessage = L["ProfileSetup_ImageDeleted"];
        }
        catch (ApiClientException)
        {
            errorMessage = L["ProfileSetup_DeleteImageError"];
        }
        finally
        {
            deletingImageId = null;
        }
    }
}
