@page "/profile/setup"
@attribute [Authorize]
@using MeetCampus.Client.Features.Profile.Resources
@using MeetCampus.Contracts.Features.Profile.Contracts
@using MeetCampus.HttpClients.Features.Profile
@using MeetCampus.HttpClients.Infrastructure.Http
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using System.Linq.Expressions
@inject IProfileSetupClient ProfileClient
@inject IStringLocalizer<ProfileResource> L
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@L["ProfileSetup_PageTitle"]</PageTitle>

<div class="bg-base-100 px-6 py-12 lg:py-20">
    <div class="mx-auto max-w-4xl">
        <section class="card bg-base-200 border-base-300 rounded-3xl border p-6 shadow-sm lg:p-8">
            <div class="mb-6 space-y-2">
                <h1 class="text-base-content text-3xl font-bold">@L["ProfileSetup_Title"]</h1>
                <p class="text-base-content/70">@L["ProfileSetup_Description"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-error mb-4">@errorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success mb-4">@successMessage</div>
            }

            @if (isLoading)
            {
                <div class="text-base-content/70">@L["ProfileSetup_Loading"]</div>
            }
            else
            {
                <EditForm EditContext="editContext" OnValidSubmit="SaveAsync" class="space-y-5">
                    <DataAnnotationsValidator />
                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@L["ProfileSetup_ProfileImage"]</legend>
                        <p class="text-base-content/70 text-sm">
                            @L["ProfileSetup_ProfileImageCount", profileImages.Count, MaximumProfileImages]
                        </p>
                        @if (profileImages.Count > 0)
                        {
                            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
                                @foreach (var image in profileImages)
                                {
                                    <div class="border-base-300 bg-base-100 relative rounded-2xl border p-3">
                                        <button class="btn btn-error btn-circle btn-sm absolute top-2 right-2 z-10 shadow"
                                                type="button"
                                                aria-label="@L["ProfileSetup_DeleteImage"]"
                                                title="@L["ProfileSetup_DeleteImage"]"
                                                disabled="@(isSaving || isUploadingImages || settingAvatarId.HasValue || deletingImageId.HasValue)"
                                                @onclick="() => DeleteProfileImageAsync(image.Id)">
                                            @if (deletingImageId == image.Id)
                                            {
                                                <span class="loading loading-spinner loading-xs" aria-hidden="true"></span>
                                            }
                                            else
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4h8v2m-11 0 1 14h12l1-14M10 11v6m4-6v6" />
                                                </svg>
                                            }
                                        </button>
                                        <img src="@image.Url" alt="@L["ProfileSetup_ProfileImageAlt"]" class="h-32 w-full rounded-xl object-cover" />
                                        @if (image.IsAvatar)
                                        {
                                            <p class="text-primary mt-2 text-sm font-semibold">@L["ProfileSetup_CurrentAvatar"]</p>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline mt-2 w-full" type="button"
                                                    disabled="@(isSaving || isUploadingImages || settingAvatarId.HasValue || deletingImageId.HasValue)"
                                                    @onclick="() => SetAvatarAsync(image.Id)">
                                                @(settingAvatarId == image.Id ? L["ProfileSetup_SavingButton"] : L["ProfileSetup_SetAsAvatar"])
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <InputFile OnChange="HandleImagesSelected" multiple accept="image/jpeg,image/png,image/webp"
                                   disabled="@(isSaving || settingAvatarId.HasValue || profileImages.Count + selectedImages.Count >= MaximumProfileImages)"
                                   class="file-input file-input-bordered w-full" />
                        @if (isUploadingImages)
                        {
                            <p class="text-base-content/70 text-sm" role="status">@L["ProfileSetup_UploadingImages"]</p>
                        }
                        <p class="text-base-content/70 text-sm">@L["ProfileSetup_ProfileImageHint"]</p>
                    </fieldset>
                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@L["Profile_Gender"]</legend>
                        <InputSelect @bind-Value="profile.GenderId" class="select select-bordered w-full">
                            <option value="">@L["ProfileSetup_SelectPlaceholder"]</option>
                            @foreach (var option in genders)
                            {
                                <option value="@option.Id">@GetDisplay(option)</option>
                            }
                        </InputSelect>
                    </fieldset>

                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@L["Profile_Sexuality"]</legend>
                        <InputSelect @bind-Value="profile.SexualityId" class="select select-bordered w-full">
                            <option value="">@L["ProfileSetup_SelectPlaceholder"]</option>
                            @foreach (var option in sexualities)
                            {
                                <option value="@option.Id">@GetDisplay(option)</option>
                            }
                        </InputSelect>
                    </fieldset>

                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@L["Profile_StudyDomain"]</legend>
                        <InputSelect @bind-Value="profile.StudyDomainId" class="@SelectClass(() => profile.StudyDomainId)">
                            <option value="">@L["ProfileSetup_SelectPlaceholder"]</option>
                            @foreach (var option in studyDomains)
                            {
                                <option value="@option.Id">@GetDisplay(option)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => profile.StudyDomainId" class="text-error text-sm mt-1" />
                    </fieldset>

                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@L["Profile_School"]</legend>
                        <InputSelect @bind-Value="profile.SchoolId" class="@SelectClass(() => profile.SchoolId)">
                            <option value="">@L["ProfileSetup_SelectPlaceholder"]</option>
                            @foreach (var option in schools)
                            {
                                <option value="@option.Id">@GetDisplay(option)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => profile.SchoolId" class="text-error text-sm mt-1" />
                    </fieldset>

                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@L["Profile_Language"]</legend>
                        <InputSelect @bind-Value="profile.LanguageId" class="@SelectClass(() => profile.LanguageId)">
                            <option value="">@L["ProfileSetup_SelectPlaceholder"]</option>
                            @foreach (var option in languages)
                            {
                                <option value="@option.Id">@GetDisplay(option)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => profile.LanguageId" class="text-error text-sm mt-1" />
                    </fieldset>

                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@L["Profile_Intention"]</legend>
                        <InputSelect @bind-Value="profile.IntentionId" class="@SelectClass(() => profile.IntentionId)">
                            <option value="">@L["ProfileSetup_SelectPlaceholder"]</option>
                            @foreach (var option in intentions)
                            {
                                <option value="@option.Id">@GetDisplay(option)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => profile.IntentionId" class="text-error text-sm mt-1" />
                    </fieldset>

                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">@L["Profile_Ethnicity"]</legend>
                        <InputSelect @bind-Value="profile.EthnicityId" class="@SelectClass(() => profile.EthnicityId)">
                            <option value="">@L["ProfileSetup_SelectPlaceholder"]</option>
                            @foreach (var option in ethnicities)
                            {
                                <option value="@option.Id">@GetDisplay(option)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => profile.EthnicityId" class="text-error text-sm mt-1" />
                    </fieldset>

                    <button class="btn btn-primary rounded-full" type="submit" disabled="@(isSaving || isUploadingImages || settingAvatarId.HasValue || deletingImageId.HasValue)">
                        @(isSaving ? L["ProfileSetup_SavingButton"] : L["ProfileSetup_SaveButton"])
                    </button>
                </EditForm>
            }
        </section>
    </div>
</div>

@code {
    private UserProfileSetupForm profile = new();
    private EditContext editContext = default!;
    private IReadOnlyList<ProfileLookupOption> genders = [];
    private IReadOnlyList<ProfileLookupOption> sexualities = [];
    private IReadOnlyList<ProfileLookupOption> studyDomains = [];
    private IReadOnlyList<ProfileLookupOption> schools = [];
    private IReadOnlyList<ProfileLookupOption> languages = [];
    private IReadOnlyList<ProfileLookupOption> intentions = [];
    private IReadOnlyList<ProfileLookupOption> ethnicities = [];
    private IReadOnlyList<ProfileImageResponse> profileImages = [];
    private List<IBrowserFile> selectedImages = [];
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = true;
    private bool isSaving;
    private bool isUploadingImages;
    private Guid? settingAvatarId;
    private Guid? deletingImageId;

    private const long MaximumProfileImageSizeBytes = 5 * 1024 * 1024;
    private const int MaximumProfileImages = 6;

    protected override void OnInitialized()
    {
        InitEditContext();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private void InitEditContext()
    {
        if (editContext is not null)
            editContext.OnValidationStateChanged -= HandleValidationStateChanged;

        editContext = new EditContext(profile);
        editContext.OnValidationStateChanged += HandleValidationStateChanged;
    }

    private void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
        => StateHasChanged();

    private async Task LoadAsync()
    {
        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            var response = await ProfileClient.GetProfileSetupAsync();
            profile = response.Profile;
            profileImages = response.ProfileImages;
            InitEditContext();
            genders = response.Genders;
            sexualities = response.Sexualities;
            studyDomains = response.StudyDomains;
            schools = response.Schools;
            languages = response.Languages;
            intentions = response.Intentions;
            ethnicities = response.Ethnicities;
        }
        catch (ApiClientException)
        {
            errorMessage = L["ProfileSetup_LoadError"];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        successMessage = null;
        isSaving = true;

        try
        {
            var request = new UpdateUserProfileRequest
            {
                GenderId = profile.GenderId,
                SexualityId = profile.SexualityId,
                StudyDomainId = profile.StudyDomainId!.Value,
                SchoolId = profile.SchoolId!.Value,
                LanguageId = profile.LanguageId!.Value,
                IntentionId = profile.IntentionId!.Value,
                EthnicityId = profile.EthnicityId!.Value,
            };

            try
            {
                await ProfileClient.UpdateProfileAsync(request);
            }
            catch (ApiClientException)
            {
                errorMessage = L["ProfileSetup_SaveError"];
                return;
            }

            if (selectedImages.Count > 0 && !await UploadSelectedImagesAsync(saveProfileBeforeUpload: false))
                return;

            successMessage = L["ProfileSetup_SaveSuccess"];
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleImagesSelected(InputFileChangeEventArgs args)
    {
        errorMessage = null;
        successMessage = null;
        IReadOnlyList<IBrowserFile> images;
        try
        {
            images = args.GetMultipleFiles(MaximumProfileImages);
        }
        catch (InvalidOperationException)
        {
            selectedImages.Clear();
            errorMessage = L["ProfileSetup_ProfileImageLimitError"];
            return;
        }

        if (profileImages.Count + images.Count > MaximumProfileImages)
        {
            selectedImages.Clear();
            errorMessage = L["ProfileSetup_ProfileImageLimitError"];
            return;
        }

        foreach (var image in images)
        {
            if (image.Size is <= 0 or > MaximumProfileImageSizeBytes)
            {
                selectedImages.Clear();
                errorMessage = L["ProfileSetup_ProfileImageSizeError"];
                return;
            }

            var contentType = image.ContentType.ToLowerInvariant();
            if (contentType is not ("image/jpeg" or "image/png" or "image/webp"))
            {
                selectedImages.Clear();
                errorMessage = L["ProfileSetup_ProfileImageTypeError"];
                return;
            }
        }

        selectedImages = images.ToList();
        await UploadSelectedImagesAsync(saveProfileBeforeUpload: true);
    }

    private async Task<bool> UploadSelectedImagesAsync(bool saveProfileBeforeUpload)
    {
        if (selectedImages.Count == 0)
            return true;

        if (saveProfileBeforeUpload && !editContext.Validate())
        {
            errorMessage = L["ProfileSetup_RequiredSelections"];
            return false;
        }

        isUploadingImages = true;
        var openedStreams = new List<Stream>(selectedImages.Count);
        try
        {
            if (saveProfileBeforeUpload)
            {
                try
                {
                    await ProfileClient.UpdateProfileAsync(CreateProfileRequest());
                }
                catch (ApiClientException)
                {
                    errorMessage = L["ProfileSetup_SaveError"];
                    return false;
                }
            }

            var uploads = new List<ProfileImageUploadRequest>(selectedImages.Count);
            foreach (var image in selectedImages)
            {
                var imageStream = image.OpenReadStream(MaximumProfileImageSizeBytes);
                openedStreams.Add(imageStream);
                uploads.Add(new ProfileImageUploadRequest(imageStream, image.Name, image.ContentType));
            }

            try
            {
                await ProfileClient.UploadProfileImagesAsync(uploads);
            }
            catch (ApiClientException)
            {
                errorMessage = L["ProfileSetup_ProfileImageUploadError"];
                return false;
            }
        }
        finally
        {
            foreach (var imageStream in openedStreams)
                await imageStream.DisposeAsync();
            isUploadingImages = false;
        }

        selectedImages.Clear();
        try
        {
            profileImages = (await ProfileClient.GetProfileSetupAsync()).ProfileImages;
        }
        catch (ApiClientException)
        {
            errorMessage = L["ProfileSetup_LoadError"];
            return false;
        }

        successMessage = L["ProfileSetup_ProfileImagesUploaded"];
        return true;
    }

    private UpdateUserProfileRequest CreateProfileRequest()
    {
        return new UpdateUserProfileRequest
        {
            GenderId = profile.GenderId,
            SexualityId = profile.SexualityId,
            StudyDomainId = profile.StudyDomainId!.Value,
            SchoolId = profile.SchoolId!.Value,
            LanguageId = profile.LanguageId!.Value,
            IntentionId = profile.IntentionId!.Value,
            EthnicityId = profile.EthnicityId!.Value,
        };
    }

    private async Task SetAvatarAsync(Guid imageId)
    {
        errorMessage = null;
        successMessage = null;
        settingAvatarId = imageId;

        try
        {
            await ProfileClient.SetAvatarAsync(imageId);
            profileImages = profileImages
                .Select(image => image with { IsAvatar = image.Id == imageId })
                .ToList();
            successMessage = L["ProfileSetup_AvatarUpdated"];
        }
        catch (ApiClientException)
        {
            errorMessage = L["ProfileSetup_AvatarUpdateError"];
        }
        finally
        {
            settingAvatarId = null;
        }
    }

    private async Task DeleteProfileImageAsync(Guid imageId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", L["ProfileSetup_DeleteImageConfirmation"].Value))
            return;

        errorMessage = null;
        successMessage = null;
        deletingImageId = imageId;

        try
        {
            await ProfileClient.DeleteProfileImageAsync(imageId);

            var deletedImage = profileImages.FirstOrDefault(image => image.Id == imageId);
            var remainingImages = profileImages.Where(image => image.Id != imageId).ToList();
            if (deletedImage?.IsAvatar == true && remainingImages.Count > 0)
            {
                var nextAvatarId = remainingImages.OrderBy(image => image.Id).First().Id;
                remainingImages = remainingImages
                    .Select(image => image with { IsAvatar = image.Id == nextAvatarId })
                    .ToList();
            }

            profileImages = remainingImages;
            successMessage = L["ProfileSetup_ImageDeleted"];
        }
        catch (ApiClientException)
        {
            errorMessage = L["ProfileSetup_DeleteImageError"];
        }
        finally
        {
            deletingImageId = null;
        }
    }

    private string SelectClass(Expression<Func<Guid?>> accessor)
    {
        var fi = FieldIdentifier.Create(accessor);
        var hasError = editContext.GetValidationMessages(fi).Any();
        return hasError
            ? "select select-bordered w-full select-error"
            : "select select-bordered w-full";
    }

    private string GetDisplay(ProfileLookupOption option)
    {
        if (string.IsNullOrWhiteSpace(option.DisplayKey))
            return option.Name;

        var localized = L[option.DisplayKey];
        return localized.ResourceNotFound ? option.Name : localized.Value;
    }

    private string GetValidationMessage(string key)
    {
        var localized = L[key];
        return localized.ResourceNotFound ? key : localized.Value;
    }

    public void Dispose()
    {
        if (editContext is not null)
            editContext.OnValidationStateChanged -= HandleValidationStateChanged;
    }
}
