@page "/auth/external-login"
@inject NavigationManager NavigationManager

<PageTitle>External login</PageTitle>
<h1>External login</h1>
<p>External provider authentication is handled by the server to preserve the provider callback and cookie flow.</p>
<button @onclick="StartExternalLogin">Continue with an external provider</button>

@code {
    private void StartExternalLogin()
    {
        NavigationManager.NavigateTo("/Account/ExternalLogin", forceLoad: true);
    }
}
