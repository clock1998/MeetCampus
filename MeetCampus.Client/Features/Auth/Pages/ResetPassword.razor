@page "/auth/reset-password"
@using System.ComponentModel.DataAnnotations
@using MeetCampus.Contracts.Features.Auth.Contracts
@using MeetCampus.HttpClients.Features.Auth
@inject IAuthClient AuthClient
@inject NavigationManager NavigationManager

<PageTitle>Reset password</PageTitle>
<h1>Reset your password</h1>
@if (code is null)
{
    <p>Invalid password reset link.</p>
}
else
{
    <EditForm Model="input" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <InputText @bind-Value="input.Email" type="email" autocomplete="username" placeholder="name@example.com" />
        <InputText @bind-Value="input.Password" type="password" autocomplete="new-password" placeholder="New password" />
        <InputText @bind-Value="input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="Confirm password" />
        <button type="submit" disabled="@busy">Reset</button>
    </EditForm>
}

@code {
    private readonly InputModel input = new();
    private string? code;
    private bool busy;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override void OnParametersSet()
    {
        code = Code;
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            return;
        }

        busy = true;
        try
        {
            var result = await AuthClient.ResetPasswordAsync(new ResetPasswordRequest(input.Email, code, input.Password));
            if (result.Succeeded)
            {
                NavigationManager.NavigateTo("/auth/reset-password-confirmation");
            }
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class InputModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 6)]
        public string Password { get; set; } = "";

        [Required, Compare(nameof(Password))]
        public string ConfirmPassword { get; set; } = "";
    }
}
