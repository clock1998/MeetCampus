@page "/auth/login-recovery-code"
@using System.ComponentModel.DataAnnotations
@using MeetCampus.Contracts.Features.Auth.Contracts
@using MeetCampus.HttpClients.Features.Auth
@inject IAuthClient AuthClient
@inject NavigationManager NavigationManager

<PageTitle>Recovery code verification</PageTitle>
<h1>Recovery code verification</h1>
<p>Enter one of your recovery codes to sign in.</p>
<EditForm Model="input" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <InputText @bind-Value="input.RecoveryCode" autocomplete="off" placeholder="Recovery code" />
    <button type="submit" disabled="@busy">Log in</button>
</EditForm>
@if (!string.IsNullOrWhiteSpace(message))
{
    <p role="alert">@message</p>
}

@code {
    private readonly InputModel input = new();
    private string? message;
    private bool busy;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private async Task SubmitAsync()
    {
        busy = true;
        var result = await AuthClient.LoginWithRecoveryCodeAsync(new RecoveryCodeLoginRequest(input.RecoveryCode));
        if (result.Succeeded)
        {
            NavigationManager.NavigateTo(GetSafeReturnUrl());
        }
        else if (result.IsLockedOut)
        {
            NavigationManager.NavigateTo("/auth/lockout");
        }
        else
        {
            message = result.ErrorMessage ?? "Invalid recovery code entered.";
        }

        busy = false;
    }

    private string GetSafeReturnUrl() =>
        string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith("//") ? "/" : ReturnUrl;

    private sealed class InputModel
    {
        [Required]
        public string RecoveryCode { get; set; } = "";
    }
}
