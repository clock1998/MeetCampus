@page "/auth/login"

@using System.ComponentModel.DataAnnotations
@using MeetCampus.Contracts.Features.Auth.Contracts
@using MeetCampus.Client.Features.Auth
@using MeetCampus.HttpClients.Features.Auth
@using MeetCampus.HttpClients.Infrastructure.Http
@inject IAuthClient AuthClient
@inject NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Log in</PageTitle>

<div class="bg-base-100 px-6 py-12 lg:py-20">
    <div class="mx-auto max-w-lg">
        <section class="card bg-base-200 border-base-300 rounded-3xl border p-6 shadow-sm lg:p-8">
            <h1 class="text-base-content mb-6 text-3xl font-bold">Log in</h1>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-error mb-4" role="alert">@errorMessage</div>
            }

            <EditForm Model="input" OnValidSubmit="LoginAsync" class="space-y-5">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-error text-sm" role="alert" />

                <InputText @bind-Value="input.Email" class="input input-bordered w-full" autocomplete="username" placeholder="name@example.com" />
                <ValidationMessage For="() => input.Email" class="text-error text-sm" />

                <InputText type="password" @bind-Value="input.Password" class="input input-bordered w-full" autocomplete="current-password" placeholder="password" />
                <ValidationMessage For="() => input.Password" class="text-error text-sm" />

                <label class="label cursor-pointer justify-start gap-3">
                    <InputCheckbox @bind-Value="input.RememberMe" class="checkbox checkbox-primary" />
                    <span class="label-text">Remember me</span>
                </label>

                <button type="submit" class="btn btn-primary w-full rounded-full" disabled="@isBusy">Log in</button>
            </EditForm>

            <div class="mt-4 text-sm">
                <a class="link link-hover" href="/auth/register">Register as a new user</a>
            </div>
        </section>
    </div>
</div>

@code {
    private readonly InputModel input = new();
    private string? errorMessage;
    private bool isBusy;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private async Task LoginAsync()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var result = await AuthClient.LoginAsync(new LoginRequest(input.Email, input.Password, input.RememberMe));
            if (result.Succeeded)
            {
                await ((ClientAuthenticationStateProvider)AuthenticationStateProvider).RefreshAsync();
                NavigationManager.NavigateTo(GetSafeReturnUrl());
                return;
            }

            if (result.RequiresTwoFactor)
            {
                NavigationManager.NavigateTo($"/auth/login-2fa?returnUrl={Uri.EscapeDataString(GetSafeReturnUrl())}");
                return;
            }

            if (result.IsLockedOut)
            {
                NavigationManager.NavigateTo("/auth/lockout");
                return;
            }

            errorMessage = result.ErrorMessage ?? "Invalid login attempt.";
        }
        catch (ApiClientException)
        {
            errorMessage = "Unable to log in. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private string GetSafeReturnUrl() =>
        string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith("//")
            ? "/"
            : ReturnUrl;

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
