@page "/auth/manage/change-password"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using MeetCampus.Contracts.Features.Auth.Contracts
@using MeetCampus.HttpClients.Features.Auth
@inject IAuthClient AuthClient

<PageTitle>Change password</PageTitle>
<h1>Change password</h1>
<EditForm Model="input" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <InputText @bind-Value="input.CurrentPassword" type="password" autocomplete="current-password" placeholder="Current password" />
    <InputText @bind-Value="input.NewPassword" type="password" autocomplete="new-password" placeholder="New password" />
    <InputText @bind-Value="input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="Confirm password" />
    <button type="submit" disabled="@busy">Update password</button>
</EditForm>
@if (message is not null) { <p role="status">@message</p> }

@code {
    private readonly InputModel input = new();
    private string? message;
    private bool busy;

    private async Task SaveAsync()
    {
        busy = true;
        var result = await AuthClient.ChangePasswordAsync(new ChangePasswordRequest(input.CurrentPassword, input.NewPassword));
        message = result.Succeeded ? "Your password has been changed." : string.Join(", ", result.Errors ?? []);
        busy = false;
    }

    private sealed class InputModel
    {
        [Required] public string CurrentPassword { get; set; } = "";
        [Required, StringLength(100, MinimumLength = 6)] public string NewPassword { get; set; } = "";
        [Required, Compare(nameof(NewPassword))] public string ConfirmPassword { get; set; } = "";
    }
}
