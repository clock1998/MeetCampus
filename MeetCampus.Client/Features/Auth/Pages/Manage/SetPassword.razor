@page "/auth/manage/set-password"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using MeetCampus.Contracts.Features.Auth.Contracts
@using MeetCampus.HttpClients.Features.Auth
@inject IAuthClient AuthClient

<PageTitle>Set password</PageTitle>
<h1>Set password</h1>
<EditForm Model="input" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <InputText @bind-Value="input.NewPassword" type="password" autocomplete="new-password" placeholder="New password" />
    <InputText @bind-Value="input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="Confirm password" />
    <button type="submit" disabled="@busy">Set password</button>
</EditForm>
@if (message is not null) { <p role="status">@message</p> }

@code {
    private readonly InputModel input = new();
    private string? message;
    private bool busy;

    private async Task SaveAsync()
    {
        busy = true;
        var result = await AuthClient.SetPasswordAsync(new SetPasswordRequest(input.NewPassword));
        message = result.Succeeded ? "Your password has been set." : string.Join(", ", result.Errors ?? []);
        busy = false;
    }

    private sealed class InputModel
    {
        [Required, StringLength(100, MinimumLength = 6)] public string NewPassword { get; set; } = "";
        [Required, Compare(nameof(NewPassword))] public string ConfirmPassword { get; set; } = "";
    }
}
