{
  "ConnectionStrings": {
    "DefaultConnection": "Host=dev-0.spikylin.com;Port=5432;Database=MeetCampus;Username=YOUR_PG_USER;Password=YOUR_PG_PASSWORD;"
  },
  "S3": {
    "Endpoint": "https://s3.spikylin.com",
    "BucketName": "meetcampus-s3",
    "AccessId": "",
    "AccessSecret": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "MeetCampus"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
