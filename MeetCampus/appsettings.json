{
  "AllowedHosts": "*",
  "BootstrapAdmin": {
    "Email": "",
    "Password": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=dev-0.spikylin.com;Port=5432;Database=MeetCampus;Username=YOUR_PG_USER;Password=YOUR_PG_PASSWORD;"
  },
  "Contact": {
    "MaxPendingOutbound": 3,
    "MaxInboundPerRolling7Days": 5,
    "PendingExpiryDays": 7,
    "RequireMutualInterestForMessaging": true,
    "RemoveRecipientFromDiscoverabilityAtCapacity": true
  },
  "Matching": {
    "NewRecommendationsPerUserPerDay": 3,
    "MaxUnseenRecommendations": 9,
    "RefreshPeriod": "daily",
    "PassedProfileSuppressionDays": 90,
    "MinimumCompatibilityScore": 30,
    "AlgorithmVersion": 1,
    "ScoringConfigurationVersion": 1,
    "UsePopularitySignals": false,
    "DisplayExactScore": false,
    "Weights": {
      "Interests": 0.25,
      "Values": 0.30,
      "SocialCommunication": 0.20,
      "LifestyleAvailability": 0.15,
      "ConnectionIntentExpectations": 0.10
    }
  },
  "Privacy": {
    "UniversityEmailPublic": false,
    "PrivateAnswersInPublicProfile": false,
    "PrivateAnswersInExplanations": false,
    "DiscoverabilityRequiresUserOptIn": true,
    "ProfileImageRequiredForDiscoverability": true,
    "ProfileImageApprovalRequiredForDiscoverability": false
  },
  "S3": {
    "Endpoint": "https://s3.spikylin.com",
    "BucketName": "meetcampus-s3",
    "AccessId": "",
    "AccessSecret": ""
  },
  "Safety": {
    "BlockingIsImmediate": true,
    "ReportingRequiredForMvp": true,
    "ModerationActionsAudited": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "MeetCampus"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Verification": {
    "TokenLifetimeMinutes": 30,
    "MaxRequestsPerHourPerAddress": 5
  }
}
