{
  "name": "meetcampus",
  "version": "1.0.0",
  "scripts": {
    "build:icons": "node scripts/copy-lucide-icons.mjs",
    "build:css": "npx @tailwindcss/cli -i ./MeetCampus/tailwind.css -o ./MeetCampus/wwwroot/app.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./MeetCampus/tailwind.css -o ./MeetCampus/wwwroot/app.css --watch",
    "dev": "npm run watch:css"
  },
  "postinstall": "npm run build:icons",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.2.2",
    "lucide-static": "1.59.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "daisyui": "^5.5.20"
  }
}
